# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OPTIONAL EXTERNAL COMPANY DATA PROVIDERS (Server-side only)
# SEC EDGAR uses a compliant User-Agent header (no API key required).
SEC_EDGAR_USER_AGENT="AureonAI/1.0 (institutional-research@aureon.example)"
# UK Companies House REST API key (https://developer.company-information.service.gov.uk/)
COMPANIES_HOUSE_API_KEY=""
# OpenCorporates API token (https://api.opencorporates.com/)
OPENCORPORATES_API_TOKEN=""
# Financial Modeling Prep API key (https://financialmodelingprep.com/)
FMP_API_KEY=""

# EMAIL DELIVERY PROVIDER (Resend - Server-side only)
# Required for live manual Executive Briefing email delivery.
RESEND_API_KEY=""
# Development testing mode uses Resend's onboarding sender (no custom domain verification required).
# In testing mode, Resend only permits delivery to the email address associated with your Resend account.
RESEND_FROM_EMAIL="AUREON AI <onboarding@resend.dev>"
